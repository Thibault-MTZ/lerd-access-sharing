#!/usr/bin/env python3
"""Point d’entrée CLI/API, exclusivement en lecture."""
import json
from pathlib import Path
import sys
sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
from access_sharing import ReadError,read_native
from native_policy import PolicyError,native_policy,effective_summary
try:
    result=read_native()
    try:
        policies={(p['site'],p['branch']):p for p in native_policy(None)}
        result['native_access_available']=True
        for row in result['shares']:
            row['access_policy_reported']=True
            row['access_summary']=effective_summary(row['project'],row['branch'] or '',policies)
        result['limits']=[
            'Les règles natives protègent les partages publics et leurs ports directs ; les partages LAN restent distincts.',
            'Le port public et les règles de passerelles externes ne sont pas fournis par cet inventaire.',
            'Un partage public actif ne garantit pas son accès depuis Internet.']
    except PolicyError:
        result['native_access_available']=False
    print(json.dumps(result,ensure_ascii=False))
except ReadError as exc:
    print(str(exc),file=sys.stderr)
    sys.exit(1)
