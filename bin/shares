#!/usr/bin/env python3
"""Point d’entrée CLI/API, exclusivement en lecture."""
import json
from pathlib import Path
import sys
sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
from access_sharing import ReadError,read_native
try:
    print(json.dumps(read_native(),ensure_ascii=False))
except ReadError as exc:
    print(str(exc),file=sys.stderr)
    sys.exit(1)
